<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ToolKits.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.ToolKits.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
    </style>

    <style name="TextAppearance.ToolKits.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!--
        Toolbar style — uses colorSurface (same as page background) so the
        top bar blends seamlessly with the rest of the app. The CoordinatorLayout
        uses colorSurface as its background, and the AppBarLayout + Toolbar
        are transparent, creating a unified edge-to-edge look.
    -->
    <style name="Widget.ToolKits.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Material3.TitleLarge</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>
</resources>
